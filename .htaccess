# Used only when the host cannot point the document root at /public.
# Preferred setup: set the document root to <project>/public and this file is ignored.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve application code, configuration, data, or tooling directly.
    # /app is the workspace, so that prefix is routed into public/ below
    # instead of being forbidden here. The rewrite still hides the app/ source tree.
    RewriteRule ^(bin|database|storage|views|vendor)(/|$) - [F,L]
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule (^|/)\. - [F,L]
    RewriteRule \.(md|sql|sqlite|log|lock|example)$ - [F,L]

    # Route everything else through /public.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
