# Copy to .env and fill in values. Never commit .env.

# local | staging | production
APP_ENV=local
APP_DEBUG=true
# Canonical public URL, no trailing slash.
APP_URL=https://atwebtech.us
# 64 hex characters. Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=

# Database: mysql (recommended) or sqlite (local testing only)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=atwebtec_us
DB_USER=atwebtech
DB_PASS=
# Used only when DB_DRIVER=sqlite. Relative paths resolve from the project root.
DB_SQLITE_PATH=storage/atwebtech.sqlite

# SMTP for every message the site sends. Leave MAIL_ENABLED=false to skip.
MAIL_ENABLED=false
MAIL_HOST=mail.atwebtech.us
MAIL_PORT=587
MAIL_ENCRYPTION=starttls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=info@atwebtech.us
MAIL_FROM_NAME=At Web Tech US
MAIL_REPLY_TO=info@atwebtech.us
MAIL_REPLY_TO_NAME=At Web Tech Query
MAIL_NOTIFY_TO=info@atwebtech.us

# Public details shown on the contact page. Leave a value blank to hide that line.
CONTACT_EMAIL=info@atwebtech.us
CONTACT_PHONE=+1 (480) 743-4017
CONTACT_ADDRESS=3672 S 16th Ave, Tucson, AZ 85713, US

# Comma-separated account emails that can open /admin and read contact messages.
# Each address must already have an atwebtech account.
ADMIN_EMAILS=

# Comma-separated integration slugs that have a working backend connection.
# Everything else is shown as "Planned". Example: INTEGRATIONS_AVAILABLE=instagram,linkedin
INTEGRATIONS_AVAILABLE=

# Google OAuth client for connecting YouTube channels (Google Cloud Console > APIs & Services > Credentials).
# Authorised redirect URI: {APP_URL}/app/channels/callback/youtube
# Leave empty to show YouTube as "Coming soon" in the Connect a New Channel window.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn OAuth for connecting a personal Profile and publishing posts (LinkedIn Developer Portal).
# Authorised redirect URI: {APP_URL}/app/channels/callback/linkedin
# Products to add on the app: "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn".
# Leave empty to show LinkedIn as "Coming soon".
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Meta app for Facebook, Instagram, and Threads (developers.facebook.com).
# Redirect URIs, once those connections are built:
# {APP_URL}/app/channels/callback/facebook
# {APP_URL}/app/channels/callback/instagram
# Leave empty to keep those channels "Coming soon". Do not list them in INTEGRATIONS_AVAILABLE before the connect flow exists.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# TikTok sandbox or production app (developers.tiktok.com → your app → Sandbox).
# Redirect URI: {APP_URL}/app/channels/callback/tiktok
# Add the TikTok account you sign in with as a sandbox target user.
# Leave empty to show TikTok as "Coming soon". Publishing is not built yet.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# AI Assistant in the post composer (OpenAI). Leave the key empty to turn the assistant off.
# AI_DAILY_LIMIT caps generations per user per day.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_LIMIT=30

# Form protection
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=10
